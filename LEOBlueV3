package org.firstinspires.ftc.teamcode;

import com.qualcomm.hardware.limelightvision.LLResult;
import com.qualcomm.hardware.limelightvision.LLResultTypes;
import com.qualcomm.hardware.limelightvision.Limelight3A;
import com.qualcomm.robotcore.eventloop.opmode.LinearOpMode;
import com.qualcomm.robotcore.eventloop.opmode.TeleOp;
import com.qualcomm.robotcore.hardware.CRServo;
import com.qualcomm.robotcore.hardware.DcMotor;
import com.qualcomm.robotcore.hardware.DcMotorSimple;
import com.qualcomm.robotcore.hardware.Servo;
import com.qualcomm.robotcore.hardware.NormalizedColorSensor;
import com.qualcomm.robotcore.hardware.NormalizedRGBA;
import com.qualcomm.robotcore.util.Range;
import android.graphics.Color;
import com.pedropathing.follower.Follower;
import com.pedropathing.revhub.drivetrains.Mecanum;
import com.pedropathing.revhub.drivetrains.MecanumConfig;
import com.pedropathing.revhub.localizers.PinpointLocalizer;
import com.pedropathing.revhub.localizers.PinpointConfig;
import com.qualcomm.hardware.gobilda.GoBildaPinpointDriver;
import org.firstinspires.ftc.robotcore.external.navigation.DistanceUnit;
import com.pedropathing.algorithm.Foresight;
import com.pedropathing.algorithm.ForesightConfig;
import com.pedropathing.controllers.PIDController;
import com.pedropathing.math.Pose;
import com.pedropathing.math.Matrix;
import com.pedropathing.math.Vector2D;
import java.util.Arrays;
import java.util.List;

@TeleOp
public class LEOBlueV3 extends LinearOpMode {
    private Limelight3A limelight;

    private static final List<Integer> TARGET_TAG_IDS = Arrays.asList(
            21, 22, 23, 24
    );

    private static final double TURRET_GAIN = 0.025;
    private static final double MIN_TURRET_POWER = 0.12;
    private static final double BEARING_DEADZONE_DEGREES = 0.5;

    @Override
    public void runOpMode() {

        initLimelight();

        MecanumConfig mecanumConfig = new MecanumConfig(c -> {
            c.frontLeftName.set("LD");
            c.frontRightName.set("RD");
            c.backLeftName.set("LB");
            c.backRightName.set("RB");
            c.frontLeftDirection.set(DcMotorSimple.Direction.FORWARD);
            c.frontRightDirection.set(DcMotorSimple.Direction.REVERSE);
            c.backLeftDirection.set(DcMotorSimple.Direction.FORWARD);
            c.backRightDirection.set(DcMotorSimple.Direction.REVERSE);
        });

        PinpointConfig localizerConfig = new PinpointConfig(c -> {
            c.name.set("pinpoint");
            c.xPodOffset.set(0.0);
            c.yPodOffset.set(0.0);
            c.xPodDirection.set(GoBildaPinpointDriver.EncoderDirection.FORWARD);
            c.yPodDirection.set(GoBildaPinpointDriver.EncoderDirection.FORWARD);
            c.offsetUnits.set(DistanceUnit.CM);
            c.globalDistanceUnit.set(DistanceUnit.CM);
            c.encoderResolutionUnit.set(DistanceUnit.CM);
            c.podType.set(GoBildaPinpointDriver.GoBildaOdometryPods.goBILDA_4_BAR_POD);
            c.resetMode.set(PinpointLocalizer.ResetMode.RECALIBRATE_IMU);
        });

        ForesightConfig foresightConfig = new ForesightConfig(c -> {
            c.headingFeedback.set(new PIDController(1.5, 0.0, 0.05));
            c.headingStaticFF.set((target, error) -> 0.0);
            c.forwardTranslational.set(new PIDController(0.1, 0.0, 0.01));
            c.strafeTranslational.set(new PIDController(0.1, 0.0, 0.01));
            c.brake.set(new PIDController(0.0, 0.0, 0.0));
            c.coast.set(new PIDController(0.0, 0.0, 0.0));
            c.holdPointTranslationalScaling.set(1.0);
            c.holdPointHeadingScaling.set(1.0);
            c.maxBrakingPower.set(1.0);
            c.maxAccelerationConstraint.set(60.0);
            c.maxVelocityConstraint.set(60.0);
            c.maxDecelerationConstraint.set(60.0);
            c.maxPathSpeed.set(1.0);
            c.maxDecelerationScale.set(1.0);
            c.brakeAggression.set(1.0);
            c.coastDownToVelocity.set(0.1);
            c.headingDeviationTolerance.set(0.1);
            c.translationalDeviationTolerance.set(0.5);
            c.brakeAtEnd.set(true);
            c.pathSkip.set(false);
            c.headingDriveRatio.set(1.0);
            c.linearBrakeCoefficients.set(Matrix.zero(2));
            c.quadraticBrakeCoefficients.set(Matrix.zero(2));
            c.headingBrakeCoefficients.set(Vector2D.cartesian(0.0, 0.0));
            c.cosineScale.set(false);
            c.maxAchievableForwardVelocity.set(100.0);
            c.maxAchievableStrafeVelocity.set(100.0);
            c.naturalForwardDeceleration.set(10.0);
            c.naturalStrafeDeceleration.set(10.0);
            c.minCorrectionDistance.set(0.5);
            c.parametricTConstraint.set(0.1);
            c.headingConstraint.set(0.1);
            c.translationalConstraint.set(0.1);
            c.velocityConstraint.set(0.1);
            c.timeoutConstraint.set(100.0);
        });

        Mecanum mecanumDrivetrain = new Mecanum(hardwareMap, mecanumConfig);
        PinpointLocalizer pinpointLocalizer = new PinpointLocalizer(hardwareMap, localizerConfig);
        Foresight foresightAlgorithm = new Foresight(foresightConfig);

        Follower follower = new Follower(pinpointLocalizer, mecanumDrivetrain, foresightAlgorithm);
        follower.setPose(new Pose(0, 0, 0));

        DcMotor intake = hardwareMap.get(DcMotor.class, "IN");
        DcMotor turretMotor = hardwareMap.get(DcMotor.class, "TM");
        CRServo turretServo = hardwareMap.get(CRServo.class, "TS");

        NormalizedColorSensor colorSensor = hardwareMap.get(NormalizedColorSensor.class, "colorSensor");
        Servo colorServo = hardwareMap.get(Servo.class, "CS");

        // brake behavior
        mecanumDrivetrain.setZeroPowerBehavior(DcMotor.ZeroPowerBehavior.BRAKE);
        intake.setZeroPowerBehavior(DcMotor.ZeroPowerBehavior.BRAKE);
        turretMotor.setZeroPowerBehavior(DcMotor.ZeroPowerBehavior.BRAKE);

        boolean pressed = false;
        double turretPower;
        boolean intakeToggleActive = false;
        boolean lastRightTriggerPressed = false;
        boolean turretMotorActive = false;
        boolean lastLeftTriggerPressed = false;

        Pose targetPose;
        boolean isAutomaticallyHolding = false;

        waitForStart();

        // Put run blocks here
        while (opModeIsActive()) {
            follower.update();

            boolean targetFound = false;
            double bearing = 0;
            double minBearingMagnitude = Double.MAX_VALUE;

            if (limelight != null) {
                LLResult result = limelight.getLatestResult();
                if (result != null && result.isValid()) {
                    List<LLResultTypes.FiducialResult> fiducialResults = result.getFiducialResults();
                    for (LLResultTypes.FiducialResult fr : fiducialResults) {
                        if (TARGET_TAG_IDS.contains(fr.getFiducialId())) {
                            targetFound = true;
                            if (Math.abs(fr.getTargetXDegrees()) < minBearingMagnitude) {
                                minBearingMagnitude = Math.abs(fr.getTargetXDegrees());
                                bearing = fr.getTargetXDegrees();
                            }
                        }
                    }
                }
            }

            if (targetFound) {
                if (Math.abs(bearing) > BEARING_DEADZONE_DEGREES) {
                    turretPower = Math.signum(bearing) * MIN_TURRET_POWER + (bearing * TURRET_GAIN);
                    turretPower = Range.clip(turretPower, -1.0, 1.0);
                } else {
                    turretPower = 0.0;
                }
                turretServo.setPower(turretPower);
            } else {
                turretPower = 0.0;
                turretServo.setPower(0.0);
            }

            boolean rightTriggerPressed = gamepad2.right_trigger > 0.5;
            if (rightTriggerPressed && !lastRightTriggerPressed) {
                intakeToggleActive = !intakeToggleActive;
            }
            lastRightTriggerPressed = rightTriggerPressed;

            if (intakeToggleActive) {
                intake.setPower(-1.0);
            } else {
                intake.setPower(0.0);
            }

            boolean leftTriggerPressed = gamepad2.left_trigger > 0.5;
            if (leftTriggerPressed && !lastLeftTriggerPressed) {
                turretMotorActive = !turretMotorActive;
            }
            lastLeftTriggerPressed = leftTriggerPressed;

            if (turretMotorActive) {
                turretMotor.setPower(1.0);
            } else {
                turretMotor.setPower(0.0);
            }

            if (gamepad1.dpad_down) {
                pressed = true;
            } else if (gamepad1.dpad_up) {
                pressed = false;
            }
            double speedMultiplier = pressed ? 0.35 : 1.0;
            double forwardPower = -gamepad1.left_stick_y;
            double strafePower = -gamepad1.left_stick_x;
            double turnPower = -gamepad1.right_stick_x;

            if (Math.abs(forwardPower) > 0.05 || Math.abs(strafePower) > 0.05 || Math.abs(turnPower) > 0.05) {
                follower.manual(forwardPower * speedMultiplier, strafePower * speedMultiplier, turnPower * speedMultiplier);
                isAutomaticallyHolding = false;
            } else {
                if (!isAutomaticallyHolding) {
                    targetPose = follower.pose();
                    follower.hold(targetPose);
                    isAutomaticallyHolding = true;
                }
            }

            NormalizedRGBA colors = colorSensor.getNormalizedColors();
            float[] hsv = new float[3];
            Color.colorToHSV(colors.toColor(), hsv);
            float hue = hsv[0];

            double colorServoPosition;
            String detectedColor;

            // color sensor stuff
            if (colors.alpha < 0.02) {
                detectedColor = "None";
                colorServoPosition = 0.5; // neutral
            } else if (hue >= 340 || hue <= 30) {
                detectedColor = "Red";
                colorServoPosition = 1.0; // red
            } else if (hue >= 40 && hue <= 90) {
                detectedColor = "Yellow";
                colorServoPosition = 0.75; // yellow
            } else {
                detectedColor = "Unknown"; // unknown
                colorServoPosition = 0.5;
            }

            colorServo.setPosition(colorServoPosition);

            telemetry.addData("X", follower.pose().x());
            telemetry.addData("Y", follower.pose().y());
            telemetry.addData("Heading", follower.pose().heading());
            telemetry.addData("Holding Active", isAutomaticallyHolding);
            telemetry.addData("Limelight Bearing", bearing);
            telemetry.addData("Turret Power", turretPower);
            telemetry.addData("Tags found", targetFound);
            telemetry.addData("Intake works", intakeToggleActive);
            telemetry.addData("Turret works", turretMotorActive);
            telemetry.addData("Detected Color", detectedColor);
            telemetry.addData("Color Hue", "%.1f", hue);
            telemetry.addData("Color Servo Pos", colorServoPosition);
            telemetry.update();

        }

        limelight.stop();
    }

    private void initLimelight() {
        limelight = hardwareMap.get(Limelight3A.class, "limelight");
        limelight.pipelineSwitch(0);
        limelight.start();
    }
}
